# Production environment for the container image.
#
#   cp docker/.env.example .env
#
# Fill in APP_KEY and the Supabase values. Nothing here is baked into the
# image; docker-compose passes it to the container at start-up.

APP_NAME="Wedding Guest Verification"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://scan.example.com

# Host port that docker-compose publishes (container listens on 80).
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Container logs go to stdout/stderr, where docker logs and collectors see them.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Supabase (PostgREST + GoTrue). Server-side only — never expose the secret key.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true whenever the site is served over HTTPS: iOS Safari refuses to
# open the camera without it.
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12

# Set when a proxy/CDN terminates TLS: "*" or a comma-separated list of CIDRs.
# Leave empty when the container is exposed directly.
TRUSTED_PROXIES=

# Run `php artisan migrate --force` on start-up (this app has no Laravel
# migrations yet; schema lives in supabase/migrations).
RUN_MIGRATIONS=false
